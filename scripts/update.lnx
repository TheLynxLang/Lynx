Roar "🐾 Updating packages..."

Set tempDir = getenv("TEMP")
If tempDir == "" {
    Set tempDir = "."
}
Set jsonFile = tempDir + "/packages.json"

Run "curl -L -o " + jsonFile + " https://raw.githubusercontent.com/justdev-chris/lynx-registry/main/packages.json"

KittyReadFile jsonFile
Set json = __file_content

KittyParseJSON json

KittyReadFile __json_file
Set content = __file_content

KittySplitString content "\n"
Set lines_count = __result_count

# First line is count
Set json_count = __result[0]

# Build a lookup array of keys and values
For i = 1 To json_count {
    Set line = __result[i]
    KittySplitString line "|"
    Set key = __result[0]
    Set value = __result[1]
    SetArrayStringElement "__temp_keys" (i - 1) key
    SetArrayStringElement "__temp_values" (i - 1) value
}

KittyReadFile "lynx.toml"
Set content = __file_content
KittySplitString content "\n"
Set lines_count = __result_count
Set in_deps = 0
Set new_toml = ""
Set updated = 0

For i = 0 To lines_count - 1 {
    Set line = __result[i]

    KittyCheckIfStringContains line "[dependencies]"
    If __result == 1 {
        in_deps = 1
        new_toml = new_toml + line + "\n"
        Continue
    }

    If in_deps == 1 {
        If line == "" {
            new_toml = new_toml + line + "\n"
            Continue
        }
        KittyCheckIfStringContains line "["
        If __result == 1 {
            in_deps = 0
            new_toml = new_toml + line + "\n"
            Continue
        }

        KittySplitString line "="
        If __result_count >= 2 {
            Set pkg = Trim(__result[0])
            Set old_version = Trim(__result[1])
            
            # Remove quotes from old_version
            KittySplitString old_version "\""
            If __result_count >= 2 {
                Set old_version = __result[1]
            }
            
            # Find the package in the temp data
            Set found_version = ""
            For j = 0 To json_count - 1 {
                Set key = __temp_keys[j]
                If key == ("packages." + pkg + ".latest") {
                    Set found_version = __temp_values[j]
                    Break
                }
            }

            If Len(found_version) > 0 {
                Roar "📦 Updating " + pkg + " (" + old_version + " → " + found_version + ")"
                new_toml = new_toml + pkg + " = \"" + found_version + "\"\n"
                Set updated = updated + 1
            } Else {
                Roar "⚠️ " + pkg + " not found in registry, keeping " + old_version
                new_toml = new_toml + line + "\n"
            }
        }
    } Else {
        new_toml = new_toml + line + "\n"
    }
}

KittyWriteFile "lynx.toml" new_toml

If updated > 0 {
    Roar "🔄 Reinstalling updated packages..."
    Run "lynx install"
    Roar "✅ Updated " + updated + " package(s)"
} Else {
    Roar "✅ All packages up to date"
}

Run "rm -f " + jsonFile
Run "rm -f " + __json_file