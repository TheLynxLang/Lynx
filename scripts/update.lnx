Roar "🐾 Updating packages..."

Run "curl -k -L -o packages.json https://raw.githubusercontent.com/justdev-chris/lynx-registry/main/packages.json --ssl-no-revoke"

KittyReadFile "packages.json"
If __result < 1 {
    Roar "⚠️ Failed to download packages.json"
    Return
}
Set json = __file_content

KittyParseJSON json

KittyReadFile __json_file
Set content = __file_content

KittySplitString content "\n"
Set lines_count = __result_count

Set json_count = __split_0

For i = 1 To json_count {
    Set line = __split_[i]
    KittySplitString line "|"
    Set key = __split_0
    Set value = __split_1
    SetArrayStringElement "__temp_keys" (i - 1) key
    SetArrayStringElement "__temp_values" (i - 1) value
}

KittyReadFile "lynx.toml"
If __result < 1 {
    Roar "⚠️ lynx.toml not found"
    Return
}
Set content = __file_content
KittySplitString content "\n"
Set lines_count = __result_count
Set in_deps = 0
Set new_toml = ""
Set updated = 0

For i = 0 To lines_count - 1 {
    Set line = __split_[i]

    Set needle1 = "[dependencies]"
    KittyCheckIfStringContains line needle1
    If __result == 1 {
        in_deps = 1
        new_toml = new_toml + line + "\n"
        Continue
    }

    If in_deps == 1 {
        If line == "" {
            new_toml = new_toml + line + "\n"
            Continue
        }
        Set needle2 = "["
        KittyCheckIfStringContains line needle2
        If __result == 1 {
            in_deps = 0
            new_toml = new_toml + line + "\n"
            Continue
        }

        KittySplitString line "="
        If __result_count >= 2 {
            Set pkg = Trim(__split_0)
            Set old_version = Trim(__split_1)
            
            KittySplitString old_version "\""
            If __result_count >= 2 {
                Set old_version = __split_1
            }
            
            Set found_version = ""
            For j = 0 To json_count - 1 {
                Set key = __temp_keys[j]
                Set pkg_latest = "packages." + pkg + ".latest"
                If key == pkg_latest {
                    Set found_version = __temp_values[j]
                    Break
                }
            }

            If Len(found_version) > 0 {
                Roar "📦 Updating " + pkg + " (" + old_version + " → " + found_version + ")"
                new_toml = new_toml + pkg + " = \"" + found_version + "\"\n"
                Set updated = updated + 1
            } Else {
                Roar "⚠️ " + pkg + " not found in registry, keeping " + old_version
                new_toml = new_toml + line + "\n"
            }
        }
    } Else {
        new_toml = new_toml + line + "\n"
    }
}

KittyWriteFile "lynx.toml" new_toml

If updated > 0 {
    Roar "🔄 Reinstalling updated packages..."
    Run "lynx install"
    Roar "✅ Updated " + updated + " package(s)"
} Else {
    Roar "✅ All packages up to date"
}

Run "rm -f packages.json"
Run "rm -f /tmp/lynx_json_*.tmp"
