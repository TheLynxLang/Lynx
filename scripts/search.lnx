Roar "🐾 Searching for: " + __term

Run "curl -k -L -o packages.json https://raw.githubusercontent.com/justdev-chris/lynx-registry/main/packages.json"

KittyReadFile "packages.json"
If __result == 0 {
    Roar "⚠️ Failed to download packages.json"
    Return
}
Set json = __file_content

KittyParseJSON json

KittyReadFile __json_file
Set content = __file_content

KittySplitString content "\n"
Set lines_count = __result_count
Set found = 0

Set count = __split_0

For i = 1 To count {
    Set line = __split_[i]
    KittySplitString line "|"
    Set key = __split_0
    Set value = __split_1
    Set needle = __term
    KittyCheckIfStringContains key needle
    If __result == 1 {
        Roar "📦 " + __term + " - " + value
        Set found = found + 1
    }
}

If found > 0 {
    Roar ""
    Roar "📦 " + found + " result(s) found"
} Else {
    Roar "❌ No results found for '" + __term + "'"
}

Run "rm -f packages.json"
Run "rm -f /tmp/lynx_json_*.tmp"