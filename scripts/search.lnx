Roar "🐾 Searching for: " + __term

Set tempDir = getenv("TEMP")
If tempDir == "" {
    Set tempDir = "."
}
Set jsonFile = tempDir + "/packages.json"

Run "curl -L -o " + jsonFile + " https://raw.githubusercontent.com/justdev-chris/lynx-registry/main/packages.json"

KittyReadFile jsonFile
Set json = __file_content

KittyParseJSON json

KittyReadFile __json_file
Set content = __file_content

KittySplitString content "\n"
Set lines_count = __result_count
Set found = 0

# First line is count - skip it
Set count = __result[0]

For i = 1 To count {
    Set line = __split[i]
    
    KittySplitString line "|"
    Set key = __split[0]
    Set value = __split[1]
    
    KittyCheckIfStringContains key __term
    If __result == 1 {
        Roar "📦 " + __term + " - " + value
        Set found = found + 1
    }
}

If found > 0 {
    Roar ""
    Roar "📦 " + found + " result(s) found"
} Else {
    Roar "❌ No results found for '" + __term + "'"
}

Run "rm -f " + jsonFile
Run "rm -f " + __json_file