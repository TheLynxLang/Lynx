Roar "🐾 Searching for: " + __term

Set tempDir = getenv("TEMP")
If tempDir == "" {
    Set tempDir = "."
}
Set jsonFile = tempDir + "/packages.json"

Run "curl -L -o packages.json https://raw.githubusercontent.com/justdev-chris/lynx-registry/main/packages.json"

KittyReadFile "packages.json"
Set json = __file_content

KittyParseJSON json

KittyReadFile __json_file
Set content = __file_content

KittySplitString content "\n"
Set lines = __result
Set lines_count = __result_count

# First line is count
Set count = lines[0]
Set found = 0

For i = 1 To count {
    Set line = lines[i]
    KittySplitString line "|"
    Set key = __result[0]
    Set value = __result[1]
    
    KittyCheckIfStringContains key __term
    If __result == 1 {
        Roar "📦 " + __term + " - " + value
        Set found = found + 1
    }
}

If found > 0 {
    Roar ""
    Roar "📦 " + found + " result(s) found"
} Else {
    Roar "❌ No results found for '" + __term + "'"
}

Run "rm -f packages.json"
Run "rm -f " + __json_file