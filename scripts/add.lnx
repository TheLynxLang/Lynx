Roar "🐾 Adding package: " + __pkg

Set pkgName = __pkg
Set version = "latest"

KittyReadFile "lynx.toml"
If __result == 0 {
    Roar "⚠️ lynx.toml not found"
    Return
}
Set content = __file_content

Set needle = pkgName + " = "
KittyCheckIfStringContains content needle

If __result == 1 {
    Roar "⚠️ " + pkgName + " already exists in dependencies"
    Return
}

Set newLine = pkgName + " = \"" + version + "\""
Set content = content + newLine + "\n"

KittyWriteFile "lynx.toml" content

Roar "✅ Added " + pkgName + " (" + version + ")"